# =================================================================
# AUTONOMOUS TRADING DESK - ENVIRONMENT CONFIGURATION
# =================================================================

# Binance API Credentials
# Get your keys at https://testnet.binancefuture.com (Testnet) or https://www.binance.com (Production)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# API Target Environment: 'TESTNET' (Sandbox) or 'PROD' (Mainnet Real)
# NOTE: In PROD, all mechanical hard gates are 100% strict (Fail-closed).
BINANCE_API_ENV=TESTNET

# Optional: Gmail Newsletter Ingestion (IMAP / App Passwords)
# Used by fetch_newsletters.py to parse crypto research feeds from tagged folders
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_google_app_password

# Optional: Notion Trading Journal Integration
# NOTION_API_KEY=secret_...
# NOTION_DATABASE_ID=your_notion_database_id_here

# Optional: GitHub Issue Auto-Reporting
# Used by scripts/report_agent_issue.py to automatically open issues on agent/setup failures
# Generate a token with 'repo' or 'issues: write' at https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_REPO=your_org_or_username/autonomous-trading-desk
