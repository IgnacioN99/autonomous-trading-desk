{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|NotebookEdit|mcp__.*|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "MSYS_NO_PATHCONV=1 wsl.exe -d <WSL_DISTRO> -- python3 <REPO_PATH_IN_WSL>/scripts/hooks/pre_trade_guard.py",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "MSYS_NO_PATHCONV=1 wsl.exe -d <WSL_DISTRO> -- python3 <REPO_PATH_IN_WSL>/scripts/hooks/post_trade_sync.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "MSYS_NO_PATHCONV=1 wsl.exe -d <WSL_DISTRO> -- python3 <REPO_PATH_IN_WSL>/scripts/hooks/post_pr_review_hook.py",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "MSYS_NO_PATHCONV=1 wsl.exe -d <WSL_DISTRO> -- python3 <REPO_PATH_IN_WSL>/scripts/hooks/pr_review_stop_hook.py --claude",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
