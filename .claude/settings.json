{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/pre_trade_guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/post_trade_sync.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
