{
  "trading-safety-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|call_mcp_tool|mcp_.*|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ../scripts/hooks/pre_trade_guard.py --agy",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command|call_mcp_tool|mcp_.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ../scripts/hooks/post_trade_sync.py",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "pr-review-trigger": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ../scripts/hooks/post_pr_review_hook.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 ../scripts/hooks/pr_review_stop_hook.py",
        "timeout": 10
      }
    ]
  }
}
