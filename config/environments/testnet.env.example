# =================================================================
# AUTONOMOUS TRADING DESK - TESTNET ENVIRONMENT CONFIGURATION
# =================================================================
# Environment: TESTNET (Binance Futures Sandbox)
# Purpose: Paper trading, algorithmic simulation, backtesting, and CI
# =================================================================

# Target execution environment identifier: TESTNET
BINANCE_API_ENV=TESTNET

# Binance Futures Testnet API Credentials
# Obtain testnet keys at: https://testnet.binancefuture.com
BINANCE_API_KEY=your_testnet_api_key_here
BINANCE_SECRET_KEY=your_testnet_secret_key_here

# Binance Futures Endpoint (Sandbox)
BINANCE_FUTURES_BASE_URL=https://testnet.binancefuture.com

# Safety Arming Flag (Not strictly required for sandbox execution)
# Keep false during automated regression tests; set true when running live simulations.
LIVE_TRADING_ARMED=false

# -----------------------------------------------------------------
# Sandbox Operational Rules:
# - Gate bypasses permitted in TESTNET for testing hypotheses (--bypass-eval-gate, --bypass-delta-gate)
# - Account equity defaults to simulated balance (~10,000 USDT)
# - Stop Loss verification retries and auto-destruct active
# -----------------------------------------------------------------

# Optional: Gmail Newsletter Ingestion (IMAP / App Passwords)
# GMAIL_USER=your_email@gmail.com
# GMAIL_APP_PASSWORD=your_16_char_google_app_password

# Optional: Notion Trading Journal Integration
# NOTION_API_KEY=secret_...
# NOTION_DATABASE_ID=your_notion_database_id_here

# Optional: GitHub Issue Auto-Reporting
# GITHUB_TOKEN=ghp_your_github_personal_access_token_here
# GITHUB_REPO=your_org_or_username/autonomous-trading-desk
