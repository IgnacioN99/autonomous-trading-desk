# =================================================================
# CREDENTIALS & SECRETS (STRICT - ZERO LEAK POLICY)
# =================================================================
.env
.env.*
!.env.example
config/environments/*.env
!config/environments/*.example
*.pem
*.key
*.secret
gmail_config.json

# =================================================================
# USER PREFERENCES & PROFILES (LOCAL DECISIONS STAY LOCAL)
# =================================================================
config/user_profile.json
!config/user_profile.json.example
config/user_context.json
!config/user_context.json.example

# =================================================================
# RUNTIME TELEMETRY & LOGS (Preserve directory structure via .gitkeep)
# =================================================================
logs/*.json
logs/*.jsonl
logs/*.lock
logs/*.md
logs/*.log
logs/*.log.*
logs/guardian_task.xml
logs/evaluations/*
logs/pr_review/
logs/issue_work/
!logs/.gitkeep
!logs/evaluations/.gitkeep

# Ephemeral batch outputs
batch_results.json
fresh_basket_results.json
review_output.md
skills-lock.json

# =================================================================
# LOCAL AGENT ARTIFACTS & PERSONAL SEARCH TOOLS
# =================================================================
.agents/scripts/
.agents/skills/*
!.agents/skills/trade-execution-planner/
!.agents/skills/trade-execution-planner/**
!.agents/skills/pr-review/
!.agents/skills/pr-review/**
!.agents/skills/issue-orchestrator/
!.agents/skills/issue-orchestrator/**
!.agents/skills/market-radar/

# =================================================================
# ONE-OFF DEPLOYMENT BATCHES & LOCAL OPERATIONAL SESSIONS
# =================================================================
scripts/deploy_*_batch.py
scripts/deploy_fresh_basket.py
docs/flujo_operativo_*.md


# =================================================================
# PYTHON & BYTECODE
# =================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# =================================================================
# VIRTUAL ENVIRONMENTS
# =================================================================
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# =================================================================
# IDE & OPERATING SYSTEM
# =================================================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
.playwright-mcp/

# =================================================================
# CLAUDE CODE
# Tracked: CLAUDE.md, .claude/settings.json, .claude/settings.local.json.example and the
# generated .claude/agents/*.md + .claude/skills/<repo skill>/SKILL.md
# (scripts/dev/sync_claude_assets.py). Per-machine settings and worktrees stay local.
# =================================================================
.claude/settings.local.json
.claude/worktrees/
!CLAUDE.md
!.claude/settings.json
!.claude/settings.local.json.example
!.claude/agents/
!.claude/skills/market-radar/
!.claude/skills/trade-execution-planner/
!.claude/skills/pr-review/
!.claude/skills/issue-orchestrator/
