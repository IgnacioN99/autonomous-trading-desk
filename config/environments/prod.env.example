# =================================================================
# AUTONOMOUS TRADING DESK - PRODUCTION ENVIRONMENT CONFIGURATION
# =================================================================
# Environment: PROD (Binance Futures Live Mainnet)
# Purpose: Real capital execution with strict quantitative hard gates
# =================================================================

# Target execution environment identifier: PROD
BINANCE_API_ENV=PROD

# Binance Futures Mainnet API Credentials
# Obtain mainnet keys at: https://www.binance.com/en/my/settings/api-management
# Permissions required: Enable Futures (TRADE), Enable Reading (READ)
# IP access restriction to trusted IPs is STRONGLY RECOMMENDED
BINANCE_API_KEY=your_production_api_key_here
BINANCE_SECRET_KEY=your_production_secret_key_here

# Binance Futures Endpoint (Mainnet)
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com

# Mandatory Safety Flag for Live Capital
# In PROD, trading execution is physically BLOCKED unless LIVE_TRADING_ARMED is explicitly true.
LIVE_TRADING_ARMED=true

# -----------------------------------------------------------------
# Production Invariants (Strict Fail-Closed Enforcement):
# 1. Gate bypasses (--bypass-eval-gate, --bypass-delta-gate) are STRICTLY FORBIDDEN.
# 2. Orders without an APPROVED subagent dossier (< 20m TTL) are rejected.
# 3. Delta-Neutral Hard Gate enforces portfolio balance (no Longs if LONG_HEAVY).
# 4. Monetary Risk Gate caps loss at dynamic equity risk (0.5% default, absolute ceiling $1.50 std / $3.75 YOLO).
# 5. Financial Friction Floor blocks setups with distance to TP1 < 0.35%.
# 6. Standard leverage is capped at 3x unless authorized in dossier as YOLO.
# 7. Unverified Stop Loss triggers atomic market liquidation (reduceOnly).
# -----------------------------------------------------------------

# Optional: Gmail Newsletter Ingestion (IMAP / App Passwords)
# GMAIL_USER=your_email@gmail.com
# GMAIL_APP_PASSWORD=your_16_char_google_app_password

# Optional: Notion Trading Journal Integration
# NOTION_API_KEY=secret_...
# NOTION_DATABASE_ID=your_notion_database_id_here

# Optional: GitHub Issue Auto-Reporting
# GITHUB_TOKEN=ghp_your_github_personal_access_token_here
# GITHUB_REPO=your_org_or_username/autonomous-trading-desk
