{
  "trading-safety-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|call_mcp_tool",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/hooks/pre_trade_guard.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command|call_mcp_tool",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/hooks/post_trade_sync.py",
            "timeout": 12
          }
        ]
      }
    ]
  },
  "pr-review-trigger": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/hooks/post_pr_review_hook.py",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
